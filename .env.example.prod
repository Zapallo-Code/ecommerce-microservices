# =============================================================================
# ECOMMERCE MICROSERVICES - PRODUCTION ENVIRONMENT VARIABLES EXAMPLE
# =============================================================================
# Copy this file to .env.prod and fill in the values
# cp .env.example.prod .env.prod
# =============================================================================
# IMPORTANT: Generate secure keys for production!
# python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
# =============================================================================

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# SECURITY WARNING: Use strong passwords in production!
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_secure_postgres_password

# =============================================================================
# DJANGO SECRET KEYS (GENERATE NEW ONES FOR PRODUCTION!)
# =============================================================================
# Use the command above to generate unique keys for each service
CATALOG_SECRET_KEY=generate-a-secure-key-for-catalog
PAYMENTS_SECRET_KEY=generate-a-secure-key-for-payments
INVENTORY_SECRET_KEY=generate-a-secure-key-for-inventory
PURCHASES_SECRET_KEY=generate-a-secure-key-for-purchases

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# Add your production frontend domains
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# =============================================================================
# LOGGING
# =============================================================================
# Recommended: WARNING or ERROR for production
LOG_LEVEL=WARNING

# =============================================================================
# ALLOWED HOSTS (add your production domains)
# =============================================================================
# Include your domain, www subdomain, and internal service names
INVENTORY_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,inventory,traefik

# =============================================================================
# DOCKER COMPOSE
# =============================================================================
COMPOSE_PROJECT_NAME=ecommerce-prod
